{
  "name": "streampark-console-webapp-v2",
  "type": "module",
  "version": "3.0.0-SNAPSHOT",
  "private": true,
  "description": "Apache StreamPark Console — Naive UI frontend",
  "author": {
    "name": "Apache StreamPark",
    "url": "https://streampark.apache.org"
  },
  "license": "Apache-2.0",
  "homepage": "https://streampark.apache.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apache/streampark.git",
    "directory": "streampark-console/streampark-console-webapp-v2"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=8.1.0"
  },
  "scripts": {
    "dev": "vite --mode dev --port 10002",
    "build": "vite build --mode production",
    "preview": "vite preview --port 10002",
    "typecheck": "vue-tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:login": "node scripts/check-login.mjs",
    "clean:cache": "rm -rf node_modules/.vite dist",
    "build:no-cache": "pnpm run clean:cache && pnpm run build",
    "lint:eslint": "eslint --cache --max-warnings 0 \"src/**/*.{vue,ts,tsx}\" --fix",
    "lint:prettier": "prettier --write \"src/**/*.{js,json,ts,tsx,css,scss,vue,html,md}\""
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "@vue/shared": "^3.5.39",
    "@vueuse/core": "^13.6.0",
    "@vueuse/shared": "^13.6.0",
    "alova": "^3.3.4",
    "colord": "^2.9.3",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "lodash-es": "^4.17.21",
    "monaco-editor": "^0.52.2",
    "naive-ui": "^2.44.1",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.4.1",
    "qs": "^6.14.0",
    "radash": "^12.1.1",
    "sortablejs": "^1.15.6",
    "sql-formatter": "^15.4.11",
    "vue": "^3.5.39",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.15.0",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.9.18",
    "@types/sortablejs": "^1.15.8",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.0.1",
    "fast-glob": "^3.3.3",
    "playwright": "1.49.1",
    "sass": "^1.89.2",
    "typescript": "^5.8.3",
    "unocss": "^66.3.3",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-icons": "^22.2.0",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^8.1.3",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue-tsc": "^3.0.5",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.28.0",
    "prettier": "^3.3.3",
    "vue-eslint-parser": "^9.4.3"
  }
}
