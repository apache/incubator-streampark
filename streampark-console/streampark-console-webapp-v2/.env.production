VITE_BASE_URL=/
VITE_APP_NAME=Apache StreamPark
VITE_HTTP_PROXY=N
VITE_ROUTE_MODE=hash
VITE_ROUTE_LOAD_MODE=dynamic
VITE_HOME_PATH=/flink/app
VITE_DEFAULT_LANG=zh_CN
VITE_AUTO_REFRESH_TOKEN=N
VITE_BUILD_COMPRESS=Y
VITE_COMPRESS_TYPE=gzip
VITE_COPYRIGHT_INFO=Copyright © Apache StreamPark
VITE_STORAGE_PREFIX=STREAMPARK__

VITE_GLOB_APP_TITLE=Apache StreamPark
VITE_GLOB_APP_SHORT_NAME=streampark
VITE_GLOB_API_URL=
VITE_GLOB_API_URL_PREFIX=
VITE_GLOB_UPLOAD_URL=/upload
